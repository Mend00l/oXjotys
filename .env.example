# Copia este fichero a `.env` y rellena los valores. El `.env` NO sube a
# GitHub: esta en el .gitignore y tiene que seguir estando.
#
# En Railway no hace falta el fichero: las mismas claves van en sus
# variables, y se cambian sin desplegar.

# El que da BotFather al crear el bot.
TELEGRAM_TOKEN=

# Tu id de Telegram, en numeros. Lo dice @userinfobot.
ADMIN_ID=

# La base de datos. En Railway la pone el la pulsar
# New -> Database -> Postgres, y se enlaza sola.
DATABASE_URL=

# Los grupos cuyos miembros pueden votar, separados por comas. El bot
# tiene que estar METIDO en cada uno para poder preguntarlo.
#   GRUPOS=-1002064045581,-1009876543210
GRUPOS=

# El enlace que se le enseña a quien no esta en ninguno.
ENLACE_DEL_GRUPO=

# Cuando cierra, en hora de España: 2026-11-09 23:59
CIERRA_EL=

# Donde se puede publicar el resultado. Sale un boton por cada uno.
PUBLICAR_EN=

# Cuantos nominados por pantalla. Vacio: 8.
POR_PAGINA=
